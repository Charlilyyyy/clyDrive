# Environment template for docker compose (copy to .env in this directory)

# JWT (min 256 bits / 32 chars for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-key-at-least-32-chars

# SMTP (Gmail example)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Seeded admin (first startup only)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@clydrive.local
ADMIN_PASSWORD=change-me
